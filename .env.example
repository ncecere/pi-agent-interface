# Chat server settings. Copy to .env.local for development.

# Where people open the app (https outside local development). Its origin is the only one allowed to write.
APP_URL=http://localhost:5177
# The address and port to listen on. A container sets HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=5178

# pi-durable-platform, and the team whose service account (role: editor) this app uses.
PLATFORM_URL=https://agents.example.com
# How people's agents are reached: `connect` (each person connects their own platform account; their agents are in
# their personal workspace) or `service` (a team service account, below). Default: service if a key is set.
# PLATFORM_AUTH=connect
# Service mode only:
PLATFORM_TEAM=pi-agent-interface
PLATFORM_SERVICE_KEY=pdp_sa_...

# Platform template for each person's assistant (empty = the platform's default), and its name in the app.
AGENT_TEMPLATE=
AGENT_NAME=Assistant
# The model every assistant runs on, by name or id, from those published to the team. New assistants get it,
# existing ones are moved to it (from their next start). Empty: the platform decides (template, then its default).
AGENT_MODEL=
# APP_NAME=Pi Agents

# At least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# While rotating SESSION_SECRET: the old one(s), comma-separated (README: Rotating SESSION_SECRET).
# SESSION_SECRET_PREVIOUS=
# SESSION_TTL_HOURS=168

# Development accounts tim, bob and sally, no password. Refused unless APP_URL is loopback.
DEV_AUTH=false
# Who DEV_AUTH offers, instead of tim, bob and sally: a JSON array of {id, name, email}. Only read while DEV_AUTH=true.
# DEV_ACCOUNTS=[{"id":"priya","name":"Priya Shah","email":"priya.shah@example.com"}]
# The chat app's own database (people, roles, settings). `pnpm db:up` starts one locally.
DATABASE_URL=postgres://pai:pai-local-only@127.0.0.1:55433/pai
# Becomes an administrator on signing in, while there is no administrator yet.
INITIAL_ADMIN_EMAIL=
# Optional features to turn off for good, comma-separated (see README: Optional features). Known: usage, myUsage
DISABLED_FEATURES=


# Single sign-on (OIDC). Redirect URI: <APP_URL>/auth/callback
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Who may sign in, and who is an administrator, by the provider's groups (comma-separated names; empty = everyone / by hand).
# OIDC_ALLOWED_GROUPS=
# OIDC_ADMIN_GROUPS=
# OIDC_GROUPS_CLAIM=groups

# Prometheus metrics on a port of their own (README: Metrics). Off unless true.
# METRICS_ENABLED=true
# METRICS_PORT=9464
# METRICS_HOST=0.0.0.0

# Production: serve the built web app (pnpm build) from here.
# STATIC_DIR=dist
