# Chat server settings. Copy to .env.local for development.

# Where people open the app (https outside local development). Its origin is the only one allowed to write.
APP_URL=http://localhost:5177
# PORT=5178

# pi-durable-platform, and the team whose service account (role: editor) this app uses.
PLATFORM_URL=https://agents.example.com
PLATFORM_TEAM=pi-agent-interface
PLATFORM_SERVICE_KEY=pdp_sa_...

# Platform template for each person's assistant (empty = the platform's default), and its name in the app.
AGENT_TEMPLATE=
AGENT_NAME=Assistant
# APP_NAME=Pi Agents

# At least 32 characters: openssl rand -base64 48
SESSION_SECRET=
# SESSION_TTL_HOURS=168

# Development accounts tim, bob and sally, no password. Refused unless APP_URL is loopback.
DEV_AUTH=false

# Single sign-on (OIDC). Redirect URI: <APP_URL>/auth/callback
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email

# Production: serve the built web app (pnpm build) from here.
# STATIC_DIR=dist
