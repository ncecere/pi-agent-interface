{
  "name": "pi-agent-interface",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Chat interface for Pi Durable agents on pi-durable-platform (UI derived from Open Chat Interface)",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gen:api": "openapi-typescript ${PLATFORM_OPENAPI:-../golang/pi-durable-platform/api/openapi.yaml} -o src/api/schema.gen.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.58",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.21",
    "ai": "7.0.55",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "katex": "0.18.2",
    "lucide-react": "1.29.0",
    "mermaid": "11.16.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.14.5",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
