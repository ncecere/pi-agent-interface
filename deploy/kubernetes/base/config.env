# pi-agent-interface-config: non-secret settings (README, "Configuration").
# Every setting is described in .env.example. Values are literal (no quotes).
# Overlays merge their own keys. Secrets (DATABASE_URL, SESSION_SECRET,
# OIDC_CLIENT_SECRET) come from the secret pi-agent-interface-runtime, never
# from here.
#
# The public https origin people reach the app at. It must match the Ingress
# host, and the OIDC redirect URI is <APP_URL>/auth/callback. Placeholder:
# overlays set it.
APP_URL=https://chat.example.org
# The Pi Durable platform people's agents are on. https.
PLATFORM_URL=https://agents.example.org
# Each person connects their own platform account (OAuth Connect). Use
# `service` only for a platform without Connect (then also PLATFORM_TEAM and
# the secret PLATFORM_SERVICE_KEY).
PLATFORM_AUTH=connect
# Single sign-on. Placeholders: overlays set the issuer and client ID.
OIDC_ISSUER=https://idp.example.org/application/o/pi-agent-interface/
OIDC_CLIENT_ID=pi-agent-interface
# Refused on a non-loopback APP_URL anyway; stated for clarity.
DEV_AUTH=false
# Becomes an administrator on signing in while there is no administrator.
# INITIAL_ADMIN_EMAIL=you@example.org
# Optional features to turn off for good, comma-separated (usage, myUsage).
# DISABLED_FEATURES=
# Must a platform account have the same email as the person's account here?
# CONNECT_EMAIL_MATCH=require
